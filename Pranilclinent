    "src/main/java/com/pranil/client/hud/HUDManager.java": """package com.pranil.client.hud;
import com.pranil.client.hud.HUDModules.*;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.DrawContext;
import java.util.*;

public class HUDManager {
    public List<HUDComponent> components = new ArrayList<>();
    public HUDManager() {
        components.add(new FPSModule()); components.add(new XYZModule());
        components.add(new CPSModule()); components.add(new KeystrokesModule());
    }
    public void render(DrawContext ctx, MinecraftClient mc) {
        for (HUDComponent c : components) if (c.isEnabled()) c.render(ctx, mc);
    }
}
