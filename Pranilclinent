    "src/main/java/com/pranil/client/hud/HUDComponent.java": """package com.pranil.client.hud;
import com.pranil.client.PranilClient;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.DrawContext;

public abstract class HUDComponent {
    public String id; public int x, y, width, height;
    public HUDComponent(String id, int dx, int dy, int w, int h) {
        this.id = id; this.width = w; this.height = h;
        this.x = PranilClient.getConfig().getX(id, dx); this.y = PranilClient.getConfig().getY(id, dy);
    }
    public abstract void render(DrawContext ctx, MinecraftClient mc);
    public abstract boolean isEnabled();
    public void renderEditor(DrawContext ctx, MinecraftClient mc) {
        ctx.fill(x, y, x + width, y + height, 0x88000000);
        ctx.drawBorder(x, y, width, height, 0xFF5865F2);
        ctx.drawCenteredTextWithShadow(mc.textRenderer, id, x + width/2, y + height/2 - 4, 0xFFFFFF);
    }
    public boolean isHovered(double mx, double my) { return mx >= x && mx <= x + width && my >= y && my <= y + height; }
    public void setPos(int nx, int ny) { this.x = nx; this.y = ny; PranilClient.getConfig().setPos(id, nx, ny); }
}
