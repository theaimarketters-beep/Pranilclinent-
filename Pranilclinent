    "src/main/java/com/pranil/client/config/ClientConfig.java": """package com.pranil.client.config;
import com.google.gson.Gson;
import com.google.gson.GsonBuilder;
import net.fabricmc.loader.api.FabricLoader;
import java.io.*;
import java.util.HashMap;
import java.util.Map;

public class ClientConfig {
    private static final Gson GSON = new GsonBuilder().setPrettyPrinting().create();
    private static final File FILE = new File(FabricLoader.getInstance().getConfigDir().toFile(), "pranil.json");
    public boolean fullbright = false, toggleSprint = true, fps = true, xyz = true, cps = true, keystrokes = true, armor = true, ping = true, crosshair = false;
    public double zoomMultiplier = 3.5;
    public Map<String, int[]> positions = new HashMap<>();

    public static ClientConfig load() {
        if (FILE.exists()) try (FileReader r = new FileReader(FILE)) { return GSON.fromJson(r, ClientConfig.class); } catch (Exception e) {}
        ClientConfig c = new ClientConfig(); c.save(); return c;
    }
    public void save() { try { FILE.getParentFile().mkdirs(); try (FileWriter w = new FileWriter(FILE)) { GSON.toJson(this, w); } } catch (Exception e) {} }
    public int getX(String id, int def) { return positions.containsKey(id) ? positions.get(id)[0] : def; }
    public int getY(String id, int def) { return positions.containsKey(id) ? positions.get(id)[1] : def; }
    public void setPos(String id, int x, int y) { positions.put(id, new int[]{x, y}); save(); }
}
