    "src/main/java/com/pranil/client/gui/HUDEditorScreen.java": """package com.pranil.client.gui;
import com.pranil.client.PranilClient;
import com.pranil.client.hud.HUDComponent;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;

public class HUDEditorScreen extends Screen {
    HUDComponent sel; int ox, oy;
    public HUDEditorScreen() { super(Text.literal("Editor")); }
    public void render(DrawContext ctx, int mx, int my, float d) {
        ctx.fill(0, 0, width, height, 0x70000000);
        for (HUDComponent c : PranilClient.getHudManager().components) c.renderEditor(ctx, client);
        super.render(ctx, mx, my, d);
    }
    public boolean mouseClicked(double mx, double my, int b) {
        for (HUDComponent c : PranilClient.getHudManager().components) if (c.isHovered(mx, my)) { sel = c; ox = (int)mx - c.x; oy = (int)my - c.y; return true; }
        return super.mouseClicked(mx, my, b);
    }
    public boolean mouseDragged(double mx, double my, int b, double dx, double dy) {
        if (sel != null) { sel.setPos((int)mx - ox, (int)my - oy); return true; } return super.mouseDragged(mx, my, b, dx, dy);
    }
    public boolean mouseReleased(double mx, double my, int b) { sel = null; return super.mouseReleased(mx, my, b); }
    public boolean shouldPause() { return false; }
}
