    "src/main/java/com/pranil/client/hud/HUDModules.java": """package com.pranil.client.hud;
import com.pranil.client.PranilClient;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.DrawContext;
import org.lwjgl.glfw.GLFW;
import java.util.*;

public class HUDModules {
    public static class FPSModule extends HUDComponent {
        public FPSModule() { super("fps", 6, 6, 60, 14); }
        public void render(DrawContext ctx, MinecraftClient mc) {
            ctx.fill(x, y, x+width, y+height, 0x90000000);
            ctx.drawText(mc.textRenderer, mc.getCurrentFps() + " FPS", x+4, y+3, 0xFFFFFF, true);
        }
        public boolean isEnabled() { return PranilClient.getConfig().fps; }
    }
    public static class XYZModule extends HUDComponent {
        public XYZModule() { super("xyz", 6, 24, 110, 14); }
        public void render(DrawContext ctx, MinecraftClient mc) {
            if (mc.player == null) return;
            ctx.fill(x, y, x+width, y+height, 0x90000000);
            ctx.drawText(mc.textRenderer, String.format("XYZ: %.0f %.0f %.0f", mc.player.getX(), mc.player.getY(), mc.player.getZ()), x+4, y+3, 0xCCCCCC, true);
        }
        public boolean isEnabled() { return PranilClient.getConfig().xyz; }
    }
    public static class CPSModule extends HUDComponent {
        List<Long> l = new ArrayList<>(); boolean wl = false;
        public CPSModule() { super("cps", 6, 42, 50, 14); }
        public void render(DrawContext ctx, MinecraftClient mc) {
            long now = System.currentTimeMillis();
            boolean cl = GLFW.glfwGetMouseButton(mc.getWindow().getHandle(), 0) == 1;
            if (cl && !wl) l.add(now); wl = cl;
            l.removeIf(t -> now - t > 1000);
            ctx.fill(x, y, x+width, y+height, 0x90000000);
            ctx.drawText(mc.textRenderer, l.size() + " CPS", x+4, y+3, 0x55FFFF, true);
        }
        public boolean isEnabled() { return PranilClient.getConfig().cps; }
    }
    public static class KeystrokesModule extends HUDComponent {
        public KeystrokesModule() { super("keys", 6, 60, 58, 38); }
        public void render(DrawContext ctx, MinecraftClient mc) {
            draw(ctx, mc, "W", x+20, y, mc.options.forwardKey.isPressed());
            draw(ctx, mc, "A", x, y+20, mc.options.leftKey.isPressed());
            draw(ctx, mc, "S", x+20, y+20, mc.options.backKey.isPressed());
            draw(ctx, mc, "D", x+40, y+20, mc.options.rightKey.isPressed());
        }
        void draw(DrawContext ctx, MinecraftClient mc, String k, int kx, int ky, boolean p) {
            ctx.fill(kx, ky, kx+18, ky+18, p ? 0xFFFFFFFF : 0x90000000);
            ctx.drawCenteredTextWithShadow(mc.textRenderer, k, kx+9, ky+5, p ? 0x000000 : 0xFFFFFF);
        }
        public boolean isEnabled() { return PranilClient.getConfig().keystrokes; }
    }
}
