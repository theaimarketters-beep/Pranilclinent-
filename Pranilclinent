    "src/main/java/com/pranil/client/PranilClient.java": """package com.pranil.client;
import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
import net.fabricmc.fabric.api.client.keybinding.v1.KeyBindingHelper;
import net.fabricmc.fabric.api.client.rendering.v1.HudRenderCallback;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.option.KeyBinding;
import net.minecraft.client.util.InputUtil;
import org.lwjgl.glfw.GLFW;
import com.pranil.client.config.ClientConfig;
import com.pranil.client.gui.PranilMenuScreen;
import com.pranil.client.gui.HUDEditorScreen;
import com.pranil.client.hud.HUDManager;

public class PranilClient implements ClientModInitializer {
    private static ClientConfig config;
    private static HUDManager hudManager;
    private static boolean isZooming = false;
    private KeyBinding menuKey, zoomKey, editorKey;

    public void onInitializeClient() {
        config = ClientConfig.load();
        hudManager = new HUDManager();
        menuKey = KeyBindingHelper.registerKeyBinding(new KeyBinding("key.pranil.menu", InputUtil.Type.KEYSYM, GLFW.GLFW_KEY_RIGHT_SHIFT, "Pranil"));
        zoomKey = KeyBindingHelper.registerKeyBinding(new KeyBinding("key.pranil.zoom", InputUtil.Type.KEYSYM, GLFW.GLFW_KEY_C, "Pranil"));
        editorKey = KeyBindingHelper.registerKeyBinding(new KeyBinding("key.pranil.editor", InputUtil.Type.KEYSYM, GLFW.GLFW_KEY_RIGHT_BRACKET, "Pranil"));
        
        ClientTickEvents.END_CLIENT_TICK.register(client -> {
            if (client.player == null) return;
            if (menuKey.wasPressed()) client.setScreen(new PranilMenuScreen());
            if (editorKey.wasPressed()) client.setScreen(new HUDEditorScreen());
            isZooming = zoomKey.isPressed();
            if (config.toggleSprint && client.options.forwardKey.isPressed()) client.options.sprintKey.setPressed(true);
        });
        HudRenderCallback.EVENT.register((ctx, tick) -> {
            if (MinecraftClient.getInstance().player != null) hudManager.render(ctx, MinecraftClient.getInstance());
        });
    }
    public static boolean isZooming() { return isZooming; }
    public static ClientConfig getConfig() { return config; }
    public static HUDManager getHudManager() { return hudManager; }
}
