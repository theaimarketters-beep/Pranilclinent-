    "src/main/java/com/pranil/client/gui/PranilMenuScreen.java": """package com.pranil.client.gui;
import com.pranil.client.PranilClient;
import com.pranil.client.config.ClientConfig;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.client.gui.widget.ButtonWidget;
import net.minecraft.text.Text;

public class PranilMenuScreen extends Screen {
    public PranilMenuScreen() { super(Text.literal("Menu")); }
    protected void init() {
        ClientConfig c = PranilClient.getConfig();
        addDrawableChild(ButtonWidget.builder(Text.literal("Fullbright: " + c.fullbright), b -> { c.fullbright = !c.fullbright; c.save(); clearAndInit(); }).dimensions(width/2-100, 50, 200, 20).build());
        addDrawableChild(ButtonWidget.builder(Text.literal("Toggle Sprint: " + c.toggleSprint), b -> { c.toggleSprint = !c.toggleSprint; c.save(); clearAndInit(); }).dimensions(width/2-100, 75, 200, 20).build());
        addDrawableChild(ButtonWidget.builder(Text.literal("Edit HUD"), b -> client.setScreen(new HUDEditorScreen())).dimensions(width/2-100, 100, 200, 20).build());
    }
    public void render(DrawContext ctx, int mx, int my, float d) {
        ctx.fill(0, 0, width, height, 0xD00B0C10);
        ctx.drawCenteredTextWithShadow(textRenderer, "Pranil Client", width/2, 20, 0xFFFFFF);
        super.render(ctx, mx, my, d);
    }
}
